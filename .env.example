# ---- Required ----
DISCORD_TOKEN=paste-your-bot-token-here
# Your Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
OWNER_ID=123456789012345678
# Your server ID (right-click the server icon > Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=123456789012345678

# ---- Identity & branding (also changeable live with /identity) ----
BOT_NAME=Sofie
BRAND_COLOR=#00C2A8

# ---- Text AI (free; pick one) ----
# groq | gemini | openrouter | ollama | none   ("none" = built-in templates only)
LLM_PROVIDER=groq
LLM_API_KEY=
# Blank = provider default. Model names change over time; check the provider's model list if one stops working.
LLM_MODEL=

# Only for ollama or another OpenAI-compatible server
LLM_BASE_URL=

# ---- Screenshot reading (free vision model) ----
# Gemini's free tier is recommended. Get a key at https://aistudio.google.com/apikey
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=

# ---- Optional ----
# Free GIPHY key for GIF posts: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# ---- Behaviour ----
# Your timezone for reports and "active hours". Market posts always use New York time.
TIMEZONE=America/New_York
DB_PATH=data/bot.db
REPORT_HOUR=18
# Hour (your timezone) for the daily "Sofie is online" DM
STATUS_HOUR=8
# on: when the bot joins your server it snapshots it and DMs you the upgrade plan (one Approve applies it all)
AUTO_REBUILD=on
# Rotating log files (also visible with journalctl on the server, or /logs in Discord)
LOG_DIR=data/logs
ACTIVE_START_HOUR=8
ACTIVE_END_HOUR=23
QUIET_MINUTES=120
MAX_STARTERS_PER_DAY=3

# ---- Self-update (optional) ----
# owner/repo on GitHub. Every restart, the bot downloads the latest code from it first (.env and data/ are never touched).
UPDATE_REPO=
# Only for a private repo: a fine-grained GitHub token with read-only "Contents" access to that one repo.
UPDATE_TOKEN=
UPDATE_BRANCH=main
